          "host": "Host",
          "cloud_password": "Passwort des Tapo-Kontos",
          "username": "Benutzername des Kamerakontos",
          "password": "Passwort des Kamerakontos",
          "control_port": "Steuerport"
        },
        "data_description": {
          "host": "IP-Adresse der Kamera. Vergib ihr im Router eine feste Adresse.",
