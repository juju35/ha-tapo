{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Tapo camera",
        "description": "In the Tapo app, turn on Third-Party Compatibility (under Me), then create a camera account in the camera's Advanced Settings.",
        "data": {
          "host": "Host",
          "cloud_password": "Tapo account password",
          "username": "Camera account username",
          "password": "Camera account password",
          "control_port": "Control port"
        },
        "data_description": {
          "host": "IP address of the camera. Give it a fixed address in your router.",
          "cloud_password": "Password of the TP-Link account the camera is added to, used for its settings.",
          "username": "Camera account, used for the video streams and the detection events.",
          "password": "Password of the camera account.",
          "control_port": "443 for cameras and doorbells."
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "The camera at {host} refused the credentials.",
        "data": {
          "cloud_password": "Tapo account password",
          "username": "Camera account username",
          "password": "Camera account password"
        }
      },
      "reconfigure": {
        "title": "Tapo camera",
        "data": {
          "host": "Host",
          "cloud_password": "Tapo account password",
          "username": "Camera account username",
          "password": "Camera account password",
          "control_port": "Control port"
        }
      }
    },
    "error": {
      "invalid_auth": "Wrong password. Use the password of the Tapo account, and check that Third-Party Compatibility is on.",
      "suspended": "The camera blocks sign-ins for a while after too many failures. Try again in a few minutes.",
      "cannot_connect": "The camera did not answer. Check its address and that ports 443, 554 and 2020 are reachable."
    },
    "abort": {
      "already_configured": "This camera is already configured.",
      "reauth_successful": "Signed in again.",
      "reconfigure_successful": "Camera updated.",
      "wrong_camera": "This address is another camera."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Tapo camera options",
        "data": {
          "scan_interval": "Refresh interval (s)",
          "onvif_events": "Detection events",
          "motion_timeout": "Detection safety timeout (s)",
          "rtsp_transport": "RTSP transport",
          "extra_ffmpeg_arguments": "Extra FFmpeg arguments for snapshots"
        },
        "data_description": {
          "scan_interval": "How often the settings are read. Detections are pushed by the camera, whatever this interval.",
          "onvif_events": "Motion, person, vehicle… sensors, from the camera's ONVIF events (port 2020).",
          "motion_timeout": "A detection without news for this long is switched off. 0 to keep it on until the camera ends it.",
          "rtsp_transport": "TCP is the most reliable.",
          "extra_ffmpeg_arguments": "Added to the FFmpeg command that takes snapshots."
        }
      }
    }
  },
